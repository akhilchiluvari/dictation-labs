# Optional cloud transcription providers. Leave both blank for the zero-cost,
# local Whisper.cpp path.
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional cleanup provider. Defaults to OpenAI-compatible chat completions.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Local Whisper.cpp paths. Use absolute paths only in your local .env/config;
# the application never commits them.
WHISPER_BINARY=whisper-cli
WHISPER_MODEL=
